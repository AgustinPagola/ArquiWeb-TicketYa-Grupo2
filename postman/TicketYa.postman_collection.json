                ]
              }
            }
          ]
        },
        {
          "name": "Pagar la reserva (aprobado)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{claveIdempotencia}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas/{{reservaId}}/pago",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas",
                "{{reservaId}}",
                "pago"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"medioPago\": \"TARJETA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Antes de ejecutar, la pre-request genera una clave de idempotencia nueva."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"claveIdempotencia\", \"pago-ok-\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });",
                  "const compra = pm.response.json();",
                  "pm.test(\"Compra APROBADA con entradas y QR\", function () {",
                  "  pm.expect(compra.estado).to.eql(\"APROBADA\");",
                  "  pm.expect(compra.entradas.length).to.eql(2);",
                  "  pm.expect(compra.entradas[0].codigoQr).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"entradaId\", compra.entradas[0].id);"
                ]
              }
            }
          ]
