ionDTO"}}}},"404":{"description":"No existe la entrada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}},"409":{"description":"Faltan menos de 72 horas, la entrada no esta vendida o ya hay una solicitud pendiente","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}}}}},"/reservas/{id}":{"get":{"tags":["Reservas y pagos"],"summary":"Consultar una reserva propia","operationId":"obtener","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-Usuario-Id","in":"header","description":"Id del cliente","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"responses":{"200":{"description":"Reserva encontrada (si vencio, se informa VENCIDA)","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReservaDTO"}}}},"403":{"description":"La reserva no es del usuario","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReservaDTO"}}}},"404":{"description":"No existe la reserva","content":{"*/*":{"schema":{"$ref":"#/components/schemas/ReservaDTO"}}}}}},"delete":{"tags":["Reservas y pagos"],"summary":"Cancelar una reserva pendiente y liberar sus lugares","operationId":"cancelar","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-Usuario-Id","in":"header","description":"Id del cliente","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"responses":{"204":{"description":"Reserva cancelada"},"403":{"description":"La reserva no es del usuario"},"404":{"description":"No existe la reserva"},"409":{"description":"La reserva no esta PENDIENTE"}}}},"/entradas":{"get":{"tags":["Entradas"],"summary":"Listar las entradas del cliente","operationId":"misEntradas","parameters":[{"name":"X-Usuario-Id","in":"header","description":"Id del cliente (sin autenticacion en la entrega 1)","required":true,"schema":{"type":"integer","format":"int64"},"example":1}],"responses":{"200":{"descrip