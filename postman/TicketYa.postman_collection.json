              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Teatro Municipal\",\n  \"direccion\": \"Calle 9 de Julio 500\",\n  \"ciudad\": \"Azul\",\n  \"latitud\": -36.78,\n  \"longitud\": -59.86,\n  \"sectores\": [\n    {\n      \"nombre\": \"Pullman\",\n      \"tipo\": \"NUMERADO\",\n      \"filas\": 4,\n      \"asientosPorFila\": 8\n    },\n    {\n      \"nombre\": \"Palco\",\n      \"tipo\": \"NO_NUMERADO\",\n      \"capacidad\": 40\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
