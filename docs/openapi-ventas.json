{"openapi":"3.1.0","info":{"title":"TicketYa - Servicio de Ventas","description":"Reserva temporal de lugares, compra con pago simulado (idempotente), entradas con QR, devoluciones y cancelacion de eventos. Garantiza que una entrada nunca se venda dos veces. Sin autenticacion en la entrega 1: el cliente se identifica con el header X-Usuario-Id y las acciones de administrador exigen X-Rol: ADMIN.","version":"1.0"},"servers":[{"url":"http://localhost:8082","description":"Generated server url"}],"tags":[{"name":"Interno","description":"Uso exclusivo entre microservicios: no se publica en el gateway"},{"name":"Devoluciones","description":"El cliente solicita la devolucion hasta 72 horas antes del evento y un administrador la resuelve"},{"name":"Disponibilidad","description":"Lugares libres de un sector. Cambia con cada compra, por eso nunca se cachea"},{"name":"Reservas y pagos","description":"Compra en dos pasos: reservar lugares por unos minutos y pagar dentro de ese plazo"},{"name":"Entradas","description":"Entradas emitidas, cada una con su codigo QR unico"}],"paths":{"/devoluciones/{id}/rechazo":{"put":{"tags":["Devoluciones"],"summary":"Rechazar una devolucion (administrador)","operationId":"rechazar","parameters":[{"name":"id","in":"path","required":true,"schema":{"type":"integer","format":"int64"}},{"name":"X-Rol","in":"header","description":"Rol del usuario","required":false,"schema":{"type":"string"},"example":"ADMIN"}],"responses":{"200":{"description":"Devolucion rechazada","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}},"403":{"description":"No es administrador","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}},"404":{"description":"No existe la devolucion","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}},"409":{"description":"La devolucion ya fue resuelta","content":{"*/*":{"schema":{"$ref":"#/components/schemas/DevolucionDTO"}}}}}}},"/devoluciones/{id}/aprobacion":{"put":{"ta