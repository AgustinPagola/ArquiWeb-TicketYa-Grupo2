    {
      "name": "2. Compra (usa el evento 1 de los datos de prueba)",
      "item": [
        {
          "name": "Disponibilidad de la Platea (antes)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/disponibilidad/eventos/{{eventoId}}/sectores/{{sectorPlatea}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "disponibilidad",
                "eventos",
                "{{eventoId}}",
                "sectores",
                "{{sectorPlatea}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Reservar 2 asientos de la Platea",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "reservas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventoId\": \"{{eventoId}}\",\n  \"sectorId\": \"{{sectorPlatea}}\",\n  \"asientos\": [\n    {\n      \"fila\": 3,\n      \"numero\": 5\n    },\n    {\n      \"fila\": 3,\n      \"numero\": 6\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Si ya corriste este flujo antes, estos asientos estarán vendidos (409): cambiá la fila y el número, o borrá la carpeta data/."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"reservaId\", pm.response.json().id);",
                  "pm.test(\"Queda PENDIENTE\", function () { pm.expect(pm.response.json().estado).to.eql(\"PENDIENTE\"); });"
                ]
              }
            }
          ]
        },
