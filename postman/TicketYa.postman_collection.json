          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", function () { pm.response.to.have.status(201); });",
                  "const lugar = pm.response.json();",
                  "pm.collectionVariables.set(\"lugarNuevoId\", lugar.id);",
                  "pm.collectionVariables.set(\"sectorNuevo1\", lugar.sectores[0].id);",
                  "pm.collectionVariables.set(\"sectorNuevo2\", lugar.sectores[1].id);"
                ]
              }
            }
          ]
