            "header": [
              {
                "key": "X-Usuario-Id",
                "value": "{{usuarioId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/reservas/{{reservaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
